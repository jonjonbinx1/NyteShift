{
  "name": "solix-ai",
  "private": true,
  "version": "0.1.0",
  "description": "SolixAI — an agentic platform with autonomous and triggered modes",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:all": "pnpm -r build",
    "dev:cli": "pnpm --filter @solix/cli dev",
    "dev:ui": "pnpm --filter @solix/ui dev",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
